# 富邦登入：可擇一
# 方式一：電子平台密碼登入（sdk.login，最簡，確定可用）
FUBON_PASSWORD=
# 方式二：API Key 登入（apikey_login，金鑰名稱字串，非 Secret）
FUBON_API_KEY=
FUBON_ID=
FUBON_CERT_PASS=
# 憑證檔以 base64 放入（避免 Render 重啟遺失檔案）；也支援本地直接放路徑
FUBON_CERT_B64=
FUBON_CERT_PATH=/tmp/fubon_cert.pfx

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRON_SECRET=

# DRY_RUN=true 時以模擬報價執行程式（不連富邦）
DRY_RUN=false